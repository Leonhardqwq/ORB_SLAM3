<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="ORB diagnostic">
  <Profiles>
    <SystemCollector Id="WaitSystem" Name="ORB wait diagnostic">
      <BufferSize Value="128"/>
      <Buffers Value="512"/>
    </SystemCollector>
    <SystemProvider Id="WaitProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="WaitProbe.Light.Memory" Name="WaitProbe" Description="Bounded scheduling diagnostic" LoggingMode="Memory" DetailLevel="Light">
      <Collectors><SystemCollectorId Value="WaitSystem"><SystemProviderId Value="WaitProvider"/></SystemCollectorId></Collectors>
    </Profile>
    <Profile Id="WaitProbe.Light.File" Name="WaitProbe" Description="Bounded duration scheduling diagnostic" LoggingMode="File" DetailLevel="Light">
      <Collectors><SystemCollectorId Value="WaitSystem"><SystemProviderId Value="WaitProvider"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
